# Primary language (Python)
*.py linguist-detectable=true
*.py linguist-language=Python

# Give JavaScript more weight
*.js linguist-detectable=true
*.jsx linguist-detectable=true
*.ts linguist-detectable=true
*.tsx linguist-detectable=true

# Show package files
package.json linguist-detectable=true
package-lock.json linguist-detectable=true

# Only hide style files
*.css linguist-vendored
*.scss linguist-vendored
*.html linguist-vendored
node_modules/* linguist-vendored

# Documentation
*.md linguist-documentation
