# Mark Python as primary
*.py linguist-detectable=true
*.py linguist-language=Python

# Specifically target the React components we want to hide
front/frontend/src/pages/TextSearch/* linguist-vendored
front/frontend/src/pages/ImageSearch/* linguist-vendored
front/frontend/src/components/* linguist-vendored

# Hide all web-related files
*.css linguist-vendored
*.html linguist-vendored
*.json linguist-vendored
*.lock linguist-vendored
node_modules/* linguist-vendored

# Keep only minimal JS visibility
*.js linguist-language=JavaScript
*.jsx linguist-language=JavaScript
