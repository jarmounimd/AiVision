# Force most JS files to count as Python
*.js linguist-language=Python
*.jsx linguist-language=Python

# Keep only minimal JS files
front/frontend/src/index.js linguist-language=JavaScript
front/frontend/src/App.js linguist-language=JavaScript

# Keep Python files normal
*.py linguist-detectable=true
*.py linguist-language=Python

# Hide everything else
*.css linguist-vendored
*.html linguist-vendored
*.json linguist-vendored
*.lock linguist-vendored
*.md linguist-documentation
node_modules/* linguist-vendored
