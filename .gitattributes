# Mark all Python files as primary
*.py linguist-language=Python

# Convert most JS/JSX to Python except core components
front/frontend/src/**/*.js linguist-language=Python
front/frontend/src/**/*.jsx linguist-language=Python

# Keep only specific React files as JavaScript
front/frontend/src/pages/Home/index.jsx linguist-language=JavaScript
front/frontend/src/pages/ImageSearch/index.jsx linguist-language=JavaScript
front/frontend/src/pages/TextSearch/index.jsx linguist-language=JavaScript

# Hide everything else
*.css linguist-vendored
*.html linguist-vendored
*.json linguist-vendored
*.lock linguist-vendored
node_modules/* linguist-vendored
__pycache__/* linguist-vendored
*.cfg linguist-vendored
*.md linguist-documentation
front/frontend/public/* linguist-vendored
front/frontend/build/* linguist-vendored
