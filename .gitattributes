# Mark Python files as primary
*.py linguist-language=Python
*.py linguist-detectable=true
*.py linguist-vendored=false

# Reduce JavaScript weight significantly
*.js linguist-vendored=true
*.jsx linguist-vendored=true
*.ts linguist-vendored=true
*.tsx linguist-vendored=true

# Hide all web-related files
*.css linguist-vendored
*.html linguist-vendored
*.json linguist-vendored
*.lock linguist-vendored
*.md linguist-vendored
node_modules/* linguist-vendored
