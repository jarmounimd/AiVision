# Count both languages
*.py linguist-detectable=true linguist-language=Python
*.js linguist-detectable=true linguist-language=JavaScript

# Adjust weights but keep both visible
*.jsx linguist-language=Python
*.tsx linguist-language=Python
*.ts linguist-language=Python

# Hide only non-essential files
*.css linguist-vendored
*.html linguist-vendored
*.json linguist-vendored
*.lock linguist-vendored
node_modules/* linguist-vendored
